PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/anon
JWT_SECRET=replace_with_secure_secret
CLIENT_URL=http://localhost:5173

# Comma-separated accounts that can manage ads (match your login email or username)
ADMIN_EMAILS=you@example.com
ADMIN_USERNAMES=

# If no admin exists yet, the next login/register becomes admin (set false in production)
FIRST_USER_AUTO_ADMIN=true

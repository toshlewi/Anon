PORT=5000
# Quote the URI if it contains & (required for shell / Vercel CLI)
MONGO_URI="mongodb://127.0.0.1:27017/anon"
# Use a long random string — required in production
JWT_SECRET=replace_with_secure_secret_min_32_chars
CLIENT_URL=http://localhost:5173

# Comma-separated accounts that can manage ads (match your login email)
ADMIN_EMAILS=you@example.com
ADMIN_USERNAMES=

# Local dev only — set false in production (use ADMIN_EMAILS instead)
FIRST_USER_AUTO_ADMIN=true
